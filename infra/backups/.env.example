# Servicio dedicado; no reutilizar las credenciales del bucket de adjuntos.
# En Railway, usar referencia a la conexión DIRECTA privada del servicio Postgres.
BACKUP_DATABASE_URL=${{Postgres.DATABASE_URL}}
BACKUP_PGSSLMODE=require
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=auleka-db-backups
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=auleka/production/postgres
# Solo clave PÚBLICA age1...; conservar la clave privada fuera de Railway.
BACKUP_AGE_RECIPIENT=
# Check externo diario: alerta por fallo o por ausencia de ejecución.
BACKUP_HEALTHCHECK_URL=
# Límite por comando de exportación/restauración. Las conexiones tienen sus propios límites.
BACKUP_COMMAND_TIMEOUT=900
