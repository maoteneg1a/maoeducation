---
interface Props {
  title?: string
}

const { title = 'THE HILDA' } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800;900&family=Lora:ital,wght@0,400;0,600;1,400&family=Caveat:wght@600;700&family=Special+Elite&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-hilda-ink font-hilda-body text-hilda-paper antialiased">
    <slot />
  </body>
</html>

<style is:global>
  html {
    background-color: #0b0a08;
    -webkit-font-smoothing: antialiased;
  }

  body {
    overflow-x: hidden;
  }
</style>
