---
import { REVEAL_CONTENT } from '../../data/the-hilda'
import Polaroid from './Polaroid.astro'
---

<section
  class="hilda-reveal"
  data-hilda-screen="reveal"
  hidden
  aria-labelledby="hilda-reveal-heading"
>
  <div class="hilda-reveal__frame">
    <h2 id="hilda-reveal-heading" class="hilda-reveal__title" tabindex="-1">{REVEAL_CONTENT.title}</h2>

    <div class="hilda-reveal__media">
      <Polaroid src={REVEAL_CONTENT.image} alt={REVEAL_CONTENT.imageAlt} rotate={-3} class="hilda-reveal__polaroid" />
      <svg class="hilda-reveal__heart" viewBox="0 0 32 28" width="48" height="42" aria-hidden="true">
        <path
          d="M16 26 C16 26 2 17.5 2 8.8 C2 3.9 5.8 1 9.6 1 C12.4 1 14.7 2.6 16 5 C17.3 2.6 19.6 1 22.4 1 C26.2 1 30 3.9 30 8.8 C30 17.5 16 26 16 26 Z"
          fill="none"
          stroke="#c9a24b"
          stroke-width="1.6"
        />
      </svg>
    </div>

    <div class="hilda-reveal__text">
      {REVEAL_CONTENT.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>

    <button type="button" class="hilda-reveal__cta" data-hilda-reveal-final>
      {REVEAL_CONTENT.cta}
    </button>
  </div>
</section>

<style>
  .hilda-reveal {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.25rem 6rem;
    background: radial-gradient(ellipse at bottom, rgba(201, 162, 75, 0.08), transparent 60%);
  }

  .hilda-reveal__frame {
    max-width: 32rem;
    width: 100%;
    text-align: center;
  }

  .hilda-reveal__title {
    font-family: 'Playfair Display', serif;
    font-weight: 900;
    font-size: clamp(1.9rem, 7vw, 2.6rem);
    letter-spacing: 0.04em;
    color: #efe6d3;
    margin: 0 0 1.75rem;
  }

  .hilda-reveal__media {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }

  .hilda-reveal__polaroid {
    max-width: 260px;
  }

  .hilda-reveal__heart {
    opacity: 0.9;
  }

  .hilda-reveal__text {
    font-family: 'Lora', serif;
    font-size: 1.05rem;
    line-height: 1.75;
    color: rgba(239, 230, 211, 0.9);
    margin-bottom: 2rem;
    text-align: left;
  }

  .hilda-reveal__text p {
    margin: 0 0 0.85rem;
  }

  .hilda-reveal__cta {
    font-family: 'Special Elite', 'Courier New', monospace;
    letter-spacing: 0.1em;
    font-size: 0.9rem;
    color: #0b0a08;
    background: linear-gradient(135deg, #e6c878, #c9a24b);
    border: none;
    padding: 0.9rem 2rem;
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 0 12px 24px -10px rgba(201, 162, 75, 0.5);
    transition: transform 0.2s ease;
  }

  .hilda-reveal__cta:hover {
    transform: translateY(-2px);
  }
</style>
