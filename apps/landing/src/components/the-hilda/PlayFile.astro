---
import { TRICK_FILE } from '../../data/the-hilda'
import ConfidentialStamp from './ConfidentialStamp.astro'
import Polaroid from './Polaroid.astro'
---

<section class="hilda-file" data-hilda-screen="file" hidden aria-labelledby="hilda-file-heading">
  <div class="hilda-file__frame">
    <div class="hilda-file__top">
      <h2 id="hilda-file-heading" class="hilda-file__title" tabindex="-1">{TRICK_FILE.title}</h2>
      <ConfidentialStamp text="Confidencial" tone="red" rotate={6} />
    </div>

    <dl class="hilda-file__list">
      <div>
        <dt>Objetivo</dt>
        <dd>{TRICK_FILE.objective}</dd>
      </div>
      <div>
        <dt>Dificultad</dt>
        <dd class="hilda-file__stars" aria-label={`${TRICK_FILE.difficultyStars} de 5 estrellas`}>
          {'★'.repeat(TRICK_FILE.difficultyStars)}
        </dd>
      </div>
      <div>
        <dt>Tiempo de preparación</dt>
        <dd>{TRICK_FILE.prepTime}</dd>
      </div>
      <div>
        <dt>Cómplices necesarios</dt>
        <dd>
          <ul class="hilda-file__accomplices">
            {TRICK_FILE.accomplices.map((item) => <li>{item}</li>)}
          </ul>
        </dd>
      </div>
      <div>
        <dt>Probabilidad de éxito</dt>
        <dd>{TRICK_FILE.successRate}</dd>
      </div>
    </dl>

    <div class="hilda-file__flowers">
      <Polaroid src="/the-hilda/images/flores.jpg" alt="Flores para acompañar el plan" caption="las flores" rotate={3} />
    </div>

    <div class="hilda-file__bottom">
      <ConfidentialStamp text="Reto aceptado" tone="gold" rotate={-3} />
    </div>

    <button type="button" class="hilda-file__cta" data-hilda-goto="plan">
      Ver el plan
    </button>
  </div>
</section>

<style>
  .hilda-file {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.25rem 6rem;
  }

  .hilda-file__frame {
    max-width: 34rem;
    width: 100%;
    border: 1px solid rgba(201, 162, 75, 0.35);
    border-radius: 10px;
    background: rgba(23, 19, 16, 0.55);
    padding: 2rem 1.5rem;
  }

  .hilda-file__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .hilda-file__title {
    font-family: 'Playfair Display', serif;
    font-weight: 800;
    font-size: 1.8rem;
    margin: 0;
    color: #efe6d3;
  }

  .hilda-file__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0 0 1.5rem;
  }

  .hilda-file__list dt {
    font-family: 'Special Elite', 'Courier New', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c9a24b;
    margin-bottom: 0.25rem;
  }

  .hilda-file__list dd {
    font-family: 'Lora', serif;
    color: rgba(239, 230, 211, 0.85);
    margin: 0;
    line-height: 1.55;
  }

  .hilda-file__stars {
    color: #e6c878;
    letter-spacing: 0.15em;
    font-size: 1.1rem;
  }

  .hilda-file__accomplices {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .hilda-file__accomplices li {
    border: 1px solid rgba(201, 162, 75, 0.35);
    border-radius: 999px;
    padding: 0.2rem 0.75rem;
    font-size: 0.85rem;
  }

  .hilda-file__flowers {
    display: flex;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .hilda-file__bottom {
    display: flex;
    justify-content: center;
    margin-bottom: 1.75rem;
  }

  .hilda-file__cta {
    display: block;
    margin: 0 auto;
    font-family: 'Special Elite', 'Courier New', monospace;
    letter-spacing: 0.1em;
    font-size: 0.9rem;
    color: #efe6d3;
    background: transparent;
    border: 1px solid rgba(201, 162, 75, 0.6);
    padding: 0.8rem 2rem;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .hilda-file__cta:hover {
    background: rgba(201, 162, 75, 0.15);
  }
</style>
