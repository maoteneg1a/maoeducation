---
interface Props {
  src?: string
  label?: string
  class?: string
}

const { src, label = 'Espacio para el QR', class: className = '' } = Astro.props
---

<div class:list={['hilda-qr', className]}>
  <span class="hilda-qr__corner hilda-qr__corner--tl" aria-hidden="true"></span>
  <span class="hilda-qr__corner hilda-qr__corner--tr" aria-hidden="true"></span>
  <span class="hilda-qr__corner hilda-qr__corner--bl" aria-hidden="true"></span>
  <span class="hilda-qr__corner hilda-qr__corner--br" aria-hidden="true"></span>

  {
    src && (
      <img
        src={src}
        alt="Código QR"
        class="hilda-qr__img"
        onerror="this.remove(); const t=this.parentElement.querySelector('[data-hilda-qr-text]'); if(t) t.hidden=false"
      />
    )
  }
  <span class="hilda-qr__text" data-hilda-qr-text hidden={Boolean(src)}>{label}</span>
</div>

<style>
  .hilda-qr {
    position: relative;
    width: 100%;
    max-width: 220px;
    aspect-ratio: 1 / 1;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed rgba(201, 162, 75, 0.6);
    background: rgba(201, 162, 75, 0.06);
    border-radius: 4px;
  }

  .hilda-qr__img {
    width: 90%;
    height: 90%;
    object-fit: contain;
  }

  .hilda-qr__text {
    font-family: 'Special Elite', 'Courier New', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: #c9a24b;
    text-align: center;
    padding: 0 1rem;
  }

  .hilda-qr__corner {
    position: absolute;
    width: 1.1rem;
    height: 1.1rem;
    border: 2px solid #c9a24b;
  }

  .hilda-qr__corner--tl {
    top: -1px;
    left: -1px;
    border-right: none;
    border-bottom: none;
  }

  .hilda-qr__corner--tr {
    top: -1px;
    right: -1px;
    border-left: none;
    border-bottom: none;
  }

  .hilda-qr__corner--bl {
    bottom: -1px;
    left: -1px;
    border-right: none;
    border-top: none;
  }

  .hilda-qr__corner--br {
    bottom: -1px;
    right: -1px;
    border-left: none;
    border-top: none;
  }
</style>
