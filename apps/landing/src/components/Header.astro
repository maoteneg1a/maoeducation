---
const appUrl = import.meta.env.PUBLIC_APP_URL || 'https://app.auleka.com'
---

<header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/90 backdrop-blur-xl">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-3">
    <a href="/" class="flex items-center" aria-label="Auleka — inicio">
      <img src="/logo.svg" alt="Auleka" width="142" height="34" class="h-8 w-auto sm:h-9" />
    </a>

    <nav class="hidden items-center gap-7 text-sm font-medium text-slate-600 md:flex">
      <a href="#clientes" class="hover:text-brand-blue">Clientes</a>
      <a href="#plataforma" class="hover:text-brand-blue">Plataforma</a>
      <a href="#features" class="hover:text-brand-blue">Funciones</a>
      <a href="#precio" class="hover:text-brand-blue">Precio</a>
      <a href="/personal" class="hover:text-brand-blue">Soy profe individual</a>
    </nav>

    <div class="flex items-center gap-3">
      <a href={appUrl} class="hidden text-sm font-semibold text-slate-600 hover:text-brand-blue sm:inline">
        Ingresar
      </a>
      <a
        href="#demo"
        class="rounded-xl bg-slate-950 px-3 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-slate-800 sm:px-4"
      >
        <span class="sm:hidden">Demo</span><span class="hidden sm:inline">Solicita una demo</span>
      </a>
    </div>
  </div>
</header>
