---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import TrustSection from '../components/TrustSection.astro'
import Features from '../components/Features.astro'
import ProductShowcase from '../components/ProductShowcase.astro'
import WhyAuleka from '../components/WhyAuleka.astro'
import DemoForm from '../components/DemoForm.astro'
import FinalCTA from '../components/FinalCTA.astro'
import Footer from '../components/Footer.astro'
---

<Layout>
  <Header />
  <main>
    <Hero />
    <TrustSection />
    <Features />
    <ProductShowcase />
    <WhyAuleka />

    <section id="precio" class="bg-slate-50 py-24">
      <div class="mx-auto max-w-6xl px-5">
        <div class="grid items-center gap-12 lg:grid-cols-[1fr_.8fr]">
          <div>
            <p class="text-sm font-bold uppercase tracking-[.18em] text-brand-blue">Una inversión clara</p>
            <h2 class="mt-4 font-display text-3xl font-bold tracking-tight text-slate-950 md:text-5xl">Tecnología que sí cabe en el presupuesto educativo.</h2>
            <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">Una sola inversión para conectar la gestión académica, el seguimiento estudiantil y la comunicación con las familias. Sin comprar módulos por separado.</p>
            <div class="mt-7 grid gap-3 sm:grid-cols-2">
              {['Configuración inicial', 'Capacitación al equipo', 'Portal para familias', 'Actualizaciones permanentes', 'Soporte local', 'Todas las funciones'].map((item) => <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700"><span class="text-emerald-600">✓</span>{item}</div>)}
            </div>
          </div>
          <div class="relative overflow-hidden rounded-3xl bg-slate-950 p-8 text-white shadow-2xl">
            <div class="absolute right-0 top-0 h-36 w-36 rounded-full bg-blue-500/20 blur-3xl"></div>
            <p class="text-sm font-semibold text-emerald-400">Plan institucional completo</p>
            <p class="mt-5 font-display text-5xl font-extrabold">$5</p>
            <p class="mt-1 text-slate-400">por familia al año</p>
            <p class="mt-6 border-t border-white/10 pt-6 text-sm leading-6 text-slate-300">Solicita una propuesta adaptada al tamaño y realidad de tu institución.</p>
            <a href="#demo" class="mt-6 inline-flex w-full justify-center rounded-xl bg-white px-6 py-3.5 font-semibold text-slate-950 transition hover:bg-blue-50">Recibir una propuesta →</a>
          </div>
        </div>
      </div>
    </section>

    <FinalCTA />
    <DemoForm />
  </main>
  <Footer />
</Layout>
