{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "pnpm docs:generate && pnpm db:generate && tsup src/server.ts --format cjs --out-dir dist",
    "start": "node dist/server.js",
    "start:prod": "pnpm db:migrate:prod && pnpm db:seed && node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "check:annex-pdf": "node scripts/check-annex-pdf.mjs",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seeds/index.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed:curriculum": "tsx scripts/seed-global-curriculum-catalog.ts",
    "docs:generate": "node ../../scripts/generate-platform-docs.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seeds/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@aws-sdk/client-s3": "^3.1061.0",
    "@fastify/compress": "^7.0.3",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "docx": "^9.7.1",
    "dotenv": "^17.3.1",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "jsonwebtoken": "^9.0.2",
    "jszip": "3.10.2",
    "pdfkit": "^0.18.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "resend": "^6.16.0",
    "sharp": "0.33.5",
    "tsx": "^4.19.2",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.17.6",
    "@types/web-push": "^3.6.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
