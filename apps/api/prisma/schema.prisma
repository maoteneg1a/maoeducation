  creator          User             @relation("TaskCreator", fields: [createdBy], references: [id])
  attachments      TaskAttachment[]
  activity         Activity?

  @@index([institutionId, courseAssignmentId])
  @@index([institutionId, dueDate])
  @@map("tasks")
}

model TaskAttachment {
  id            String   @id @default(uuid())
  taskId        String   @map("task_id")
  institutionId String   @map("institution_id")
  fileName      String   @map("file_name") @db.VarChar(255)
  storedName    String   @map("stored_name") @db.VarChar(255)
  mimeType      String   @map("mime_type") @db.VarChar(100)
  fileSize      Int      @map("file_size")
  uploadedBy    String   @map("uploaded_by")
  createdAt     DateTime @default(now()) @map("created_at")

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader User @relation("AttachmentUploader", fields: [uploadedBy], references: [id])

  @@map("task_attachments")
}

// ============================================================
// PLATAFORMA (SUPERADMIN GLOBAL — NO pertenece a ninguna institución)
// ============================================================

model PlatformAdmin {
  id           String    @id @default(uuid())
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  name         String    @db.VarChar(150)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("platform_admins")
}

// Lead de marketing: prospecto que solicita una demo desde la landing (auleka.com).
// NO pertenece a ninguna institución (es pre-tenant).
model Lead {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(150)
  email           String   @db.VarChar(255)
  phone           String?  @db.VarChar(50)
  institutionName String?  @map("institution_name") @db.VarChar(200)
  city            String?  @db.VarChar(100)
  role            String?  @db.VarChar(80) // rector | dueño | docente | otro
  studentsCount   Int?     @map("students_count")
  message         String?  @db.Text
  source          String   @default("landing") @db.VarChar(50)
  status          String   @default("new") @db.VarChar(30) // new | contacted | demo | won | lost
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("leads")
}

// Vista de página de la landing (auleka.com). Tracker propio, sin PII: visitorId
// es un hash anónimo generado en el cliente (localStorage), no un identificador real.
model PageView {
  id        String   @id @default(uuid())
  path      String   @db.VarChar(255)
  referrer  String?  @db.VarChar(500)
  visitorId String?  @map("visitor_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([path, createdAt])
  @@map("page_views")
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("verification_tokens")
}

// ============================================================
// SUSCRIPCIONES (cobro manual por transferencia)
// ============================================================

// Una suscripción por institución. Las cuentas personales de docentes también
// son instituciones por debajo, así que quedan cubiertas por el mismo modelo.
//
// El estado efectivo (activa / gracia / solo-lectura) NO se guarda: se deriva de
// expiresAt + graceDays en cada lectura. Guardar un status sería garantizar que
// se quede viejo — nadie corre un cron para moverlo cuando pasa la medianoche.
//
// Una institución SIN fila de suscripción no tiene restricciones. Es lo que
// mantiene funcionando a las instituciones que ya existían antes de este módulo:
// se les crea la suscripción a mano cuando corresponda.
model Subscription {
  id            String    @id @default(uuid())
  institutionId String    @unique @map("institution_id")
  /// trial | paid — qué clase de período es el vigente.
  plan          String    @default("trial") @db.VarChar(20)
  startsAt      DateTime  @map("starts_at")
  expiresAt     DateTime  @map("expires_at")
  /// Días de tolerancia tras el vencimiento antes de pasar a solo-lectura.
  graceDays     Int       @default(7) @map("grace_days")
  /// Corte manual del superadmin: bloquea sin importar las fechas.
  suspendedAt   DateTime? @map("suspended_at")
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  institution Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  payments    SubscriptionPayment[]

  @@index([expiresAt])
  @@map("subscriptions")
}

// Comprobante de transferencia subido por el admin de la institución, más la
// revisión del superadmin. Aprobar un pago es lo que mueve expiresAt.
model SubscriptionPayment {
  id             String    @id @default(uuid())
  subscriptionId String    @map("subscription_id")
  institutionId  String    @map("institution_id")
  /// pending | approved | rejected
  status         String    @default("pending") @db.VarChar(20)
  amount         Decimal?  @db.Decimal(10, 2)
  currency       String    @default("USD") @db.VarChar(3)
  /// Fecha en que el cliente dice haber hecho la transferencia.
  transferredAt  DateTime? @map("transferred_at")
  /// Banco y/o número de comprobante, como lo escribe el cliente.
  reference      String?   @db.VarChar(160)
  notes          String?   @db.Text

  // Captura del comprobante (mismo patrón que incident_attachments)
  fileName   String @map("file_name") @db.VarChar(255)
  storedName String @map("stored_name") @db.VarChar(255)
  mimeType   String @map("mime_type") @db.VarChar(100)
  fileSize   Int    @map("file_size")
  uploadedBy String @map("uploaded_by")

  // Revisión del superadmin
  reviewedAt  DateTime? @map("reviewed_at")
  /// platform_admins.id — sin FK porque no es un User del tenant.
  reviewedBy  String?   @map("reviewed_by")
  reviewNotes String?   @map("review_notes") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  institution  Institution  @relation(fields: [institutionId], references: [id])
  uploader     User         @relation("SubscriptionPaymentUploader", fields: [uploadedBy], references: [id])

  @@index([status, createdAt])
  @@index([institutionId, createdAt])
  @@map("subscription_payments")
}
