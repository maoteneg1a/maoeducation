generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // En producción con PgBouncer: DATABASE_URL apunta al pooler (puerto del
  // pooler, con ?pgbouncer=true) y DIRECT_URL a la conexión directa de Postgres
  // (la usan migrate/introspect, que no pueden ir por el pooler).
  // En local ambas pueden ser la misma URL.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// CORE: IDENTIDAD E INSTITUCIÓN
// ============================================================

model Institution {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(200)
  code      String   @unique @db.VarChar(50)
  settings  Json     @default("{}")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                     User[]
  roles                     Role[]
  levels                    Level[]
  subjects                  Subject[]
  academicYears             AcademicYear[]
  parallels                 Parallel[]
  activityTypes             ActivityType[]
  courseAssignments         CourseAssignment[]
  studentEnrollments        StudentEnrollment[]
  activities                Activity[]
  grades                    Grade[]
  attendanceRecords         AttendanceRecord[]
  absenceJustifications     AbsenceJustification[]
  disciplinaryIncidents     DisciplinaryIncident[]
  incidentTypes             IncidentType[]
  incidentEvents            IncidentEvent[]
  incidentCommitments       IncidentCommitment[]
  incidentAttachments       IncidentAttachment[]
  parentMeetings            ParentMeeting[]
  anamnesisTemplates        AnamnesisTemplate[]
  anamnesisRecords          AnamnesisRecord[]
  behaviorGrades            BehaviorGrade[]
  subjectRecoveries         SubjectRecovery[]
  pedagogicRecoveries       PedagogicRecovery[]
  promotionDecisions        PromotionDecision[]
  messageThreads            MessageThread[]
  scheduleEntries           ScheduleEntry[]
  reportTemplates           ReportTemplate[]
  auditLogs                 AuditLog[]
  insumos                   Insumo[]
  tasks                     Task[]
  curriculumAreas           CurriculumArea[]
  competencyAreas           CompetencyArea[]
  planningTemplates         PlanningTemplate[]
  curriculumPlans           CurriculumPlan[]
  learningSituations        LearningSituation[]
  planningWeeks             PlanningWeek[]
  reinforcementPlans        ReinforcementPlan[]
  interdisciplinaryProjects InterdisciplinaryProject[]
  multigradeGroups          MultigradeGroup[]
  multigradeSharedExperiences MultigradeSharedExperience[]
  subscription              Subscription?
  subscriptionPayments      SubscriptionPayment[]

  @@map("institutions")
}

model User {
  id              String    @id @default(uuid())
  institutionId   String    @map("institution_id")
  email           String    @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id])
  profile     Profile?
  userRoles   UserRole[]

  // Relaciones como actor
  teacherAssignments    CourseAssignment[]     @relation("TeacherAssignments")
  multigradeGroupsAsTeacher MultigradeGroup[]  @relation("MultigradeGroupTeacher")
  createdActivities     Activity[]             @relation("ActivityCreator")
  recordedGrades        Grade[]                @relation("GradeRecorder")
  recordedAttendance    AttendanceRecord[]     @relation("AttendanceRecorder")
  reportedIncidents     DisciplinaryIncident[] @relation("IncidentReporter")
  createdJustifications AbsenceJustification[] @relation("JustificationCreator")
  sentMessages          Message[]              @relation("MessageSender")
  messageRecipients     MessageRecipient[]
  createdThreads        MessageThread[]        @relation("ThreadCreator")
  createdInsumos        Insumo[]               @relation("InsumoCreator")
  createdTasks          Task[]                 @relation("TaskCreator")
  uploadedAttachments   TaskAttachment[]       @relation("AttachmentUploader")
  uploadedReceipts      SubscriptionPayment[]  @relation("SubscriptionPaymentUploader")

  // Relaciones como alumno
  studentEnrollments    StudentEnrollment[]    @relation("StudentEnrollments")
  studentGrades         Grade[]                @relation("StudentGrades")
  studentAttendance     AttendanceRecord[]     @relation("StudentAttendance")
  studentIncidents      DisciplinaryIncident[] @relation("StudentIncidents")
  studentJustifications AbsenceJustification[] @relation("StudentJustifications")

  // Relaciones de incidentes (debido proceso)
  deceIncidents               DisciplinaryIncident[] @relation("IncidentDece")
  incidentEvents              IncidentEvent[]        @relation("IncidentEventActor")
  incidentCommitments         IncidentCommitment[]   @relation("IncidentCommitmentCreator")
  incidentAttachmentsUploaded IncidentAttachment[]   @relation("IncidentAttachmentUploader")

  // Atención a padres (bitácora)
  parentMeetingsAsStudent ParentMeeting[] @relation("StudentParentMeetings")
  parentMeetingsRecorded  ParentMeeting[] @relation("ParentMeetingRecorder")

  // Anamnesis
  studentAnamnesis AnamnesisRecord[] @relation("StudentAnamnesis")
  createdAnamnesis AnamnesisRecord[] @relation("AnamnesisCreator")

  // Comportamiento
  studentBehavior  BehaviorGrade[] @relation("StudentBehavior")
  recordedBehavior BehaviorGrade[] @relation("BehaviorRecorder")

  // Promoción y recuperaciones
  pushSubscriptions                  PushSubscription[]
  studentRecoveries                  SubjectRecovery[]                  @relation("StudentRecovery")
  recordedRecoveries                 SubjectRecovery[]                  @relation("RecoveryRecorder")
  studentPedagogicRecoveries         PedagogicRecovery[]                @relation("StudentPedagogicRecovery")
  recordedPedagogicRecoveries        PedagogicRecovery[]                @relation("PedagogicRecoveryRecorder")
  studentReinforcementPlans          ReinforcementPlan[]                @relation("StudentReinforcementPlan")
  createdReinforcementPlans          ReinforcementPlan[]                @relation("ReinforcementPlanCreator")
  reinforcementCaseParticipations    ReinforcementCaseStudent[]         @relation("ReinforcementCaseStudent")
  createdReinforcementCommunications ReinforcementCommunication[]       @relation("ReinforcementCommunicationCreator")
  createdReinforcementCommitments    ReinforcementCommitment[]          @relation("ReinforcementCommitmentCreator")
  createdReinforcementFollowUps      ReinforcementFollowUp[]            @relation("ReinforcementFollowUpCreator")
  createdReinforcementReevaluations  ReinforcementReevaluation[]        @relation("ReinforcementReevaluationCreator")
  reinforcementReevaluationOutcomes  ReinforcementReevaluationOutcome[] @relation("ReinforcementReevaluationOutcomeStudent")
  createdInterdisciplinaryProjects   InterdisciplinaryProject[]         @relation("InterdisciplinaryProjectCreator")
  studentPromotions                  PromotionDecision[]                @relation("StudentPromotion")
  decidedPromotions                  PromotionDecision[]                @relation("PromotionDecider")
  createdMultigradeGroups            MultigradeGroup[]                  @relation("MultigradeGroupCreator")
  createdMultigradeExperiences       MultigradeSharedExperience[]        @relation("MultigradeExperienceCreator")

  // Planificación curricular (PCA/PUD)
  createdCurriculumPlans     CurriculumPlan[]    @relation("CurriculumPlanCreator")
  approvedCurriculumPlans    CurriculumPlan[]    @relation("CurriculumPlanApprover")
  createdLearningSituations  LearningSituation[] @relation("LearningSituationCreator")
  reviewedLearningSituations LearningSituation[] @relation("LearningSituationReviewer")
  approvedLearningSituations LearningSituation[] @relation("LearningSituationApprover")

  // Relaciones de tutor/padre
  guardianOf       GuardianStudent[] @relation("GuardianRelation")
  studentGuardians GuardianStudent[] @relation("StudentRelation")
  tutoredParallels Parallel[]        @relation("ParallelTutor")

  assignedRoles UserRole[] @relation("RoleAssigner")

  @@unique([institutionId, email])
  @@map("users")
}

model Profile {
  id                    String    @id @default(uuid())
  userId                String    @unique @map("user_id")
  firstName             String    @map("first_name") @db.VarChar(100)
  lastName              String    @map("last_name") @db.VarChar(100)
  dni                   String?   @db.VarChar(20)
  phone                 String?   @db.VarChar(30)
  birthDate             DateTime? @map("birth_date") @db.Date
  avatarUrl             String?   @map("avatar_url") @db.VarChar(500)
  // Datos ampliados (matrícula / representante)
  phoneAlt              String?   @map("phone_alt") @db.VarChar(30)
  address               String?   @db.VarChar(300)
  occupation            String?   @db.VarChar(120)
  nationality           String?   @db.VarChar(60)
  placeOfBirth          String?   @map("place_of_birth") @db.VarChar(120)
  bloodType             String?   @map("blood_type") @db.VarChar(10)
  gender                String?   @db.VarChar(20)
  emergencyContactName  String?   @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactPhone String?   @map("emergency_contact_phone") @db.VarChar(30)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model GuardianStudent {
  guardianId         String  @map("guardian_id")
  studentId          String  @map("student_id")
  relationship       String  @default("guardian") @db.VarChar(50) // padre | madre | tutor_legal | otro
  isPrimary          Boolean @default(false) @map("is_primary")
  isLegalRep         Boolean @default(false) @map("is_legal_rep")
  livesWithStudent   Boolean @default(false) @map("lives_with_student")
  isEmergencyContact Boolean @default(false) @map("is_emergency_contact")

  guardian User @relation("GuardianRelation", fields: [guardianId], references: [id], onDelete: Cascade)
  student  User @relation("StudentRelation", fields: [studentId], references: [id], onDelete: Cascade)

  @@id([guardianId, studentId])
  @@map("guardian_students")
}

// ============================================================
// RBAC
// ============================================================

model Role {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  name          String   @db.VarChar(100)
  label         String   @db.VarChar(100)
  isSystem      Boolean  @default(false) @map("is_system")
  createdAt     DateTime @default(now()) @map("created_at")

  institution     Institution      @relation(fields: [institutionId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([institutionId, name])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  resource    String  @db.VarChar(100)
  action      String  @db.VarChar(50)
  scope       String  @default("all") @db.VarChar(50)
  description String? @db.VarChar(200)

  rolePermissions RolePermission[]

  @@unique([resource, action, scope])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedBy String?  @map("assigned_by")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assigner User? @relation("RoleAssigner", fields: [assignedBy], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

// ============================================================
// ESTRUCTURA ACADÉMICA
// ============================================================

model AcademicYear {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  name          String   @db.VarChar(50)
  startDate     DateTime @map("start_date") @db.Date
  endDate       DateTime @map("end_date") @db.Date
  isActive      Boolean  @default(false) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  institution        Institution         @relation(fields: [institutionId], references: [id])
  academicPeriods    AcademicPeriod[]
  parallels          Parallel[]
  enrollments        StudentEnrollment[]
  courseAssignments  CourseAssignment[]
  subjectRecoveries  SubjectRecovery[]
  promotionDecisions PromotionDecision[]
  multigradeGroups   MultigradeGroup[]

  @@unique([institutionId, name])
  @@map("academic_years")
}

model AcademicPeriodScheme {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  name          String   @db.VarChar(100)
  code          String   @db.VarChar(50)
  periodsCount  Int      @map("periods_count") @db.SmallInt
  config        Json     @default("{}")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")

  academicPeriods AcademicPeriod[]

  @@map("academic_period_schemes")
}

model AcademicPeriod {
  id             String   @id @default(uuid())
  academicYearId String   @map("academic_year_id")
  schemeId       String   @map("scheme_id")
  periodNumber   Int      @map("period_number") @db.SmallInt
  name           String   @db.VarChar(100)
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  isActive       Boolean  @default(false) @map("is_active")
  isClosed       Boolean  @default(false) @map("is_closed")

  academicYear              AcademicYear               @relation(fields: [academicYearId], references: [id])
  scheme                    AcademicPeriodScheme       @relation(fields: [schemeId], references: [id])
  activities                Activity[]
  insumos                   Insumo[]
  behaviorGrades            BehaviorGrade[]
  pedagogicRecoveries       PedagogicRecovery[]
  learningSituations        LearningSituation[]
  reinforcementPlans        ReinforcementPlan[]
  interdisciplinaryProjects InterdisciplinaryProject[]
  multigradeSharedExperiences MultigradeSharedExperience[]

  @@unique([academicYearId, periodNumber])
  @@map("academic_periods")
}

model Level {
  id             String   @id @default(uuid())
  institutionId  String   @map("institution_id")
  name           String   @db.VarChar(100)
  code           String   @db.VarChar(20)
  sortOrder      Int      @map("sort_order") @db.SmallInt
  isActive       Boolean  @default(true) @map("is_active")
  // Modo de asistencia del nivel: "per_subject" (por materia) | "daily" (diaria por paralelo)
  attendanceMode String   @default("per_subject") @map("attendance_mode") @db.VarChar(20)
  // Subnivel del currículo MINEDUC al que pertenece este grado: inicial | elemental | media | superior | bgu
  // Determina qué banco curricular (CurriculumSkill) se le ofrece al docente.
  subnivel       String?  @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")

  institution Institution @relation(fields: [institutionId], references: [id])
  parallels   Parallel[]

  @@unique([institutionId, code])
  @@map("levels")
}

model Parallel {
  id             String  @id @default(uuid())
  institutionId  String  @map("institution_id")
  levelId        String  @map("level_id")
  academicYearId String  @map("academic_year_id")
  tutorId        String? @map("tutor_id")
  name           String  @db.VarChar(10)
  capacity       Int?    @db.SmallInt
  isActive       Boolean @default(true) @map("is_active")
  // Solo aplica a paralelos de BGU (1BGU-3BGU): BACHILLERATO_CIENCIAS | BACHILLERATO_TECNICO.
  // La carga horaria oficial (CurricularWorkload) se bifurca por esta oferta a partir de BGU.
  educationOffer String? @map("education_offer") @db.VarChar(30)

  institution               Institution                @relation(fields: [institutionId], references: [id])
  level                     Level                      @relation(fields: [levelId], references: [id])
  academicYear              AcademicYear               @relation(fields: [academicYearId], references: [id])
  tutor                     User?                      @relation("ParallelTutor", fields: [tutorId], references: [id])
  enrollments               StudentEnrollment[]
  courseAssignments         CourseAssignment[]
  attendanceRecords         AttendanceRecord[]
  interdisciplinaryProjects InterdisciplinaryProject[]
  multigradeGroupMembers    MultigradeGroupMember[]

  @@unique([levelId, academicYearId, name])
  @@map("parallels")
}

model Subject {
  id               String   @id @default(uuid())
  institutionId    String   @map("institution_id")
  name             String   @db.VarChar(150)
  code             String?  @db.VarChar(20)
  description      String?
  isActive         Boolean  @default(true) @map("is_active")
  // Materia cualitativa: se califica con notas pero en la libreta se muestra como
  // letra (A+…F−) y NO entra en el promedio general.
  isQualitative    Boolean  @default(false) @map("is_qualitative")
  // Vínculo opcional al área del currículo oficial (banco de destrezas MINEDUC).
  // Si es null, la materia no tiene banco curricular asociado (ej. materias propias
  // de la institución sin equivalente oficial).
  curriculumAreaId String?  @map("curriculum_area_id")
  // Vínculo equivalente al banco por COMPETENCIAS — se usa cuando el
  // planningModel de la institución es "competencias" en vez de "destrezas".
  competencyAreaId String?  @map("competency_area_id")
  // Código de materia según la tabla oficial de carga horaria (CurricularWorkload.subjectCodes),
  // ej. "M", "LL", "ECA" — null si esta materia no tiene carga horaria oficial (propia de la institución).
  workloadCode     String?  @map("workload_code") @db.VarChar(30)
  createdAt        DateTime @default(now()) @map("created_at")

  institution       Institution        @relation(fields: [institutionId], references: [id])
  curriculumArea    CurriculumArea?    @relation(fields: [curriculumAreaId], references: [id])
  competencyArea    CompetencyArea?    @relation(fields: [competencyAreaId], references: [id])
  courseAssignments CourseAssignment[]
  multigradeGroupMembers MultigradeGroupMember[]

  @@unique([institutionId, code])
  @@map("subjects")
}

// ============================================================
// BANCO CURRICULAR MINEDUC (Currículo Priorizado con Énfasis en Competencias)
// ============================================================
// Jerarquía: Área -> Criterio de evaluación -> Destreza con criterio de
// desempeño (la desagregación oficial que ya hace el Ministerio). El docente
// SELECCIONA de este banco al armar su PUD; no lo escribe desde cero.
// Seedeado por institución desde DEFAULT_CURRICULUM (institution-bootstrap.ts),
// editable/ampliable por institución (isCustom = true para lo que agreguen).

model CurriculumArea {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  code          String   @db.VarChar(20) // ej: "LL", "MAT", "CCNN"
  name          String   @db.VarChar(150) // ej: "Lengua y Literatura"
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  institution Institution           @relation(fields: [institutionId], references: [id])
  criteria    CurriculumCriterion[]
  subjects    Subject[]

  @@unique([institutionId, code])
  @@map("curriculum_areas")
}

model CurriculumCriterion {
  id          String   @id @default(uuid())
  areaId      String   @map("area_id")
  // Subnivel MINEDUC: inicial | elemental | media | superior | bgu
  subnivel    String   @db.VarChar(20)
  code        String   @db.VarChar(30) // ej: "CE.LL.5.1"; en Inicial = objetivo de aprendizaje
  description String
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  area   CurriculumArea    @relation(fields: [areaId], references: [id])
  skills CurriculumSkill[]

  @@unique([areaId, subnivel, code])
  @@map("curriculum_criteria")
}

model CurriculumSkill {
  id             String   @id @default(uuid())
  criterionId    String   @map("criterion_id")
  code           String   @db.VarChar(30) // ej: "LL.5.1.1"; en Inicial = destreza por tramo de edad
  description    String
  indicatorText  String?  @map("indicator_text") // Indicador de evaluación oficial (I.LL.5.1.1...)
  // Tags de la iconografía oficial: tipo de competencia e inserción curricular.
  competencyTags String[] @map("competency_tags") // comunicacional | matematica | digital | socioemocional
  insercionTags  String[] @map("insercion_tags") // civica | socioemocional | vial | sostenible | financiera
  profileRefs    String[] @map("profile_refs") // refs al Perfil de Salida: J.1, I.2, S.4...
  // true = agregada por la institución (no viene del banco oficial seedeado)
  isCustom       Boolean  @default(false) @map("is_custom")
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  criterion               CurriculumCriterion      @relation(fields: [criterionId], references: [id])
  activities              Activity[]
  PedagogicRecovery       PedagogicRecovery[]
  sabers                  CurriculumSaber[]
  reinforcementPlanSkills ReinforcementPlanSkill[]

  @@unique([criterionId, code])
  @@map("curriculum_skills")
}

// Desagregación de una destreza en los 3 tipos de "saberes" que usa el formato
// institucional de Planificación Microcurricular (declarativo/procedimental/
// actitudinal). No viene en los PDFs oficiales del MINEDUC — banco propio de la
// institución, se llena la primera vez que se usa y se reutiliza después.
model CurriculumSaber {
  id          String   @id @default(uuid())
  skillId     String   @map("skill_id")
  type        String   @db.VarChar(20) // declarativo | procedimental | actitudinal
  code        String   @db.VarChar(30) // ej: "LL.4.1.d.1"
  description String
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  skill CurriculumSkill @relation(fields: [skillId], references: [id])

  @@unique([skillId, code])
  @@map("curriculum_sabers")
}

// ============================================================
// BANCO CURRICULAR POR COMPETENCIAS (modelo alternativo, configurable)
// ============================================================
// Jerarquía: Área -> Competencia específica -> Indicadores + Saberes (mismo
// patrón declarativo/procedimental/actitudinal que en destrezas). A diferencia
// del banco por destrezas, aquí NO hay un nivel "criterio" intermedio — la
// competencia específica lo reemplaza directamente, siguiendo la fuente real
// del Currículo Nacional por Competencias (CNC) del MINEDUC.
// Institution.settings.planningModel decide cuál de los dos bancos usa cada
// institución (ver extractPlanningModel en institution.repository).

model CompetencyArea {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  code          String   @db.VarChar(20)
  name          String   @db.VarChar(150)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  institution  Institution  @relation(fields: [institutionId], references: [id])
  competencies Competency[]
  subjects     Subject[]

  @@unique([institutionId, code])
  @@map("competency_areas")
}

model Competency {
  id                 String   @id @default(uuid())
  areaId             String   @map("area_id")
  // Subnivel MINEDUC: inicial | preparatoria | elemental | media | superior | bgu
  subnivel           String   @db.VarChar(20)
  code               String   @db.VarChar(30) // ej: "CE.M.5.1"
  text               String
  // Códigos de KeyCompetency (catálogo fijo global) que esta competencia desarrolla
  keyCompetencyCodes String[] @map("key_competency_codes")
  isCustom           Boolean  @default(false) @map("is_custom")
  isActive           Boolean  @default(true) @map("is_active")
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at")

  area                    CompetencyArea           @relation(fields: [areaId], references: [id])
  indicators              CompetencyIndicator[]
  sabers                  CompetencySaber[]
  reinforcementPlanSkills ReinforcementPlanSkill[]
  activities              Activity[]

  @@unique([areaId, subnivel, code])
  @@map("competencies")
}

model CompetencyIndicator {
  id           String   @id @default(uuid())
  competencyId String   @map("competency_id")
  code         String   @db.VarChar(30) // ej: "I.M.5.1.1"
  text         String
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  competency Competency @relation(fields: [competencyId], references: [id])

  @@unique([competencyId, code])
  @@map("competency_indicators")
}

model CompetencySaber {
  id           String   @id @default(uuid())
  competencyId String   @map("competency_id")
  type         String   @db.VarChar(20) // declarativo | procedimental | actitudinal
  code         String   @db.VarChar(30) // ej: "M.5.1.d.1"
  description  String
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  competency Competency @relation(fields: [competencyId], references: [id])

  @@unique([competencyId, code])
  @@map("competency_sabers")
}

// Carga horaria oficial (períodos semanales por grado+materia), fuente: Acuerdo
// MINEDUC-2023-00008-A, art. 7. Global (no por institución) — sin redistribuciones
// inventadas, calcado de TIGA. Un mismo grado+materia puede matchear una entrada
// "OFFICIAL_INDIVIDUAL" (weeklyPeriods ya resuelto) o "OFFICIAL_GROUPED" (requiere
// que la institución reparta groupWeeklyPeriods entre sus materias vía
// CourseAssignment.weeklyPeriodsOverride).
model CurricularWorkload {
  id                 String   @id @default(uuid())
  sublevel           String   @db.VarChar(20) // preparatoria | elemental | media | superior | bachillerato
  levelCodes         String[] @map("level_codes") // ej: ["2B","3B","4B"] — códigos de Level.code que matchean
  educationOffer     String   @map("education_offer") @db.VarChar(30) // EGB | BACHILLERATO_CIENCIAS | BACHILLERATO_TECNICO
  subjectCodes       String[] @map("subject_codes") // ej: ["ECA","EF"] — matchea contra Subject.workloadCode
  weeklyPeriods      Int?     @map("weekly_periods") // solo si sourceType = OFFICIAL_INDIVIDUAL
  groupWeeklyPeriods Int?     @map("group_weekly_periods") // solo si sourceType = OFFICIAL_GROUPED
  periodMinutes      Int      @map("period_minutes") @db.SmallInt
  sourceType         String   @map("source_type") @db.VarChar(30) // OFFICIAL_INDIVIDUAL | OFFICIAL_GROUPED
  sourceDocument     String   @map("source_document")
  notes              String?

  @@map("curricular_workloads")
}

// Catálogo fijo y global (no por institución) de las 7 competencias clave
// transversales del CNC-MINEDUC — se etiquetan en cada Competency.
model KeyCompetency {
  id          String  @id @default(uuid())
  code        String  @unique @db.VarChar(10) // CC | CMCT | CCICC | CD | CSE | CECA | CIT
  name        String  @db.VarChar(100)
  shortName   String  @map("short_name") @db.VarChar(50)
  description String
  color       String? @db.VarChar(10)
  sortOrder   Int     @default(0) @map("sort_order")

  @@map("key_competencies")
}

// ============================================================
// CATÁLOGOS OPERATIVOS (DUA y evaluación) — compartidos por ambos modelos de
// planificación, globales (no por institución). El docente SELECCIONA de aquí
// en vez de redactar desde cero; la IA los usa para no poder "inventar" DUA/
// técnicas fuera de lo permitido.
// ============================================================

model DuaCheckpoint {
  id               String @id @default(uuid())
  operationalCode  String @unique @map("operational_code") @db.VarChar(20) // ej: "I.1.1"
  principleName    String @map("principle_name") @db.VarChar(50) // Representación | Acción y Expresión | Motivación
  guidelineNumber  Int    @map("guideline_number")
  guidelineName    String @map("guideline_name") @db.VarChar(150)
  checkpointNumber String @map("checkpoint_number") @db.VarChar(10)
  checkpointText   String
  sortOrder        Int    @default(0) @map("sort_order")

  strategies DuaStrategy[]

  @@map("dua_checkpoints")
}

model DuaStrategy {
  id                 String   @id @default(uuid())
  checkpointId       String   @map("checkpoint_id")
  text               String
  // ANTICIPATION | CONSTRUCTION | CONSOLIDATION — para filtrar por momento pedagógico
  compatiblePhases   String[] @map("compatible_phases")
  compatiblePurposes String[] @map("compatible_purposes")
  sourcePage         Int?     @map("source_page")

  checkpoint DuaCheckpoint @relation(fields: [checkpointId], references: [id])

  @@map("dua_strategies")
}

model AssessmentTechnique {
  id                        String   @id @default(uuid())
  code                      String   @unique @db.VarChar(30)
  label                     String   @db.VarChar(150)
  compatibleInstrumentCodes String[] @map("compatible_instrument_codes")
  sortOrder                 Int      @default(0) @map("sort_order")

  @@map("assessment_techniques")
}

model AssessmentInstrument {
  id        String @id @default(uuid())
  code      String @unique @db.VarChar(30)
  label     String @db.VarChar(150)
  sortOrder Int    @default(0) @map("sort_order")

  @@map("assessment_instruments")
}

// ============================================================
// EJES DE INSERCIÓN CURRICULAR (bancos de referencia transversal) — el docente
// los consulta al redactar, no bloquean nada; son candidatos textuales ya
// extraídos de los documentos oficiales de cada eje, no una jerarquía nueva.
// ============================================================

model CurricularInsertionBank {
  id    String @id @default(uuid())
  key   String @unique @db.VarChar(50) // SOCIOEMOTIONAL_EDUCATION | SUSTAINABLE_DEVELOPMENT | ...
  title String @db.VarChar(150)

  candidates CurricularInsertionCandidate[]

  @@map("curricular_insertion_banks")
}

model CurricularInsertionCandidate {
  id         String @id @default(uuid())
  bankId     String @map("bank_id")
  sourceCode String @map("source_code") @db.VarChar(30) // código de destreza/competencia asociado en el documento fuente
  text       String
  page       Int?

  bank CurricularInsertionBank @relation(fields: [bankId], references: [id])

  @@index([bankId, sourceCode])
  @@map("curricular_insertion_candidates")
}

model CourseAssignment {
  id                    String   @id @default(uuid())
  institutionId         String   @map("institution_id")
  teacherId             String   @map("teacher_id")
  subjectId             String   @map("subject_id")
  parallelId            String   @map("parallel_id")
  academicYearId        String   @map("academic_year_id")
  isActive              Boolean  @default(true) @map("is_active")
  examWeight            Int      @default(30) @map("exam_weight")
  // Períodos semanales institucionales — SOLO se usa cuando la carga oficial (CurricularWorkload)
  // es un bloque agrupado (ej. "ECA+EF"=5, "Currículo Integrador"=25) y la institución debe repartirlo
  // entre sus materias. Si la carga oficial ya es individual, este campo se ignora.
  weeklyPeriodsOverride Int?     @map("weekly_periods_override") @db.SmallInt
  createdAt             DateTime @default(now()) @map("created_at")

  institution                    Institution                     @relation(fields: [institutionId], references: [id])
  teacher                        User                            @relation("TeacherAssignments", fields: [teacherId], references: [id])
  subject                        Subject                         @relation(fields: [subjectId], references: [id])
  parallel                       Parallel                        @relation(fields: [parallelId], references: [id])
  academicYear                   AcademicYear                    @relation(fields: [academicYearId], references: [id])
  activities                     Activity[]
  insumos                        Insumo[]
  attendance                     AttendanceRecord[]
  schedule                       ScheduleEntry[]
  tasks                          Task[]
  recoveries                     SubjectRecovery[]
  pedagogicRecoveries            PedagogicRecovery[]
  curriculumPlans                CurriculumPlan[]
  reinforcementPlans             ReinforcementPlan[]
  interdisciplinaryContributions InterdisciplinaryContribution[]
  multigradeGroupMember          MultigradeGroupMember?

  @@unique([subjectId, parallelId, academicYearId])
  @@map("course_assignments")
}

// ============================================================
// PLANIFICACIÓN CURRICULAR (PCA / PUD)
// ============================================================
// PlanningTemplate: secciones/campos configurables por institución (patrón
// AnamnesisTemplate). CurriculumPlan = PCA (uno por CourseAssignment+año).
// PlanningUnit = PUD (una por unidad/bloque dentro del PCA).

// Solo para PCA — la microplanificación (situación de aprendizaje + semanas) tiene
// estructura FIJA porque debe reproducir el formato oficial "Planificación
// Microcurricular" de la institución, no una plantilla configurable.
model PlanningTemplate {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  type          String   @db.VarChar(10) // "pca"
  name          String   @db.VarChar(150)
  isDefault     Boolean  @default(false) @map("is_default")
  isActive      Boolean  @default(true) @map("is_active")
  schema        Json     @default("{}") // { sections: [{ title, fields: [{ key, label, type, required, options }] }] }
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution Institution      @relation(fields: [institutionId], references: [id])
  plans       CurriculumPlan[]

  @@map("planning_templates")
}

model CurriculumPlan {
  id                 String    @id @default(uuid())
  institutionId      String    @map("institution_id")
  courseAssignmentId String    @map("course_assignment_id")
  templateId         String    @map("template_id")
  // DEPRECADO — "borrador" | "enviado" | "aprobado". El PCA/Planificación por
  // Competencias tenía su propio flujo de aprobación por terceros, INDEPENDIENTE
  // del de sus LearningSituation hijas, lo que producía estados contradictorios
  // en la UI (plan "Aprobado" con situaciones en "Borrador" — el docente no
  // entendía qué significaba cada cosa). Pedido explícito del usuario: la única
  // señal de completitud vive en LearningSituation.status (borrador/listo); el
  // plan padre ya no tiene flujo de aprobación propio y este campo deja de
  // escribirse (se conserva la columna por histórico, igual que approvedBy/
  // approvedAt debajo). No usar para gating de UI ni de negocio — ver
  // PlanningListPage (indicador derivado de las situaciones reales).
  status             String    @default("borrador") @db.VarChar(20)
  data               Json      @default("{}") // objetivos, ejes transversales, campos configurables del template
  createdBy          String    @map("created_by")
  approvedBy         String?   @map("approved_by")
  approvedAt         DateTime? @map("approved_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  institution      Institution         @relation(fields: [institutionId], references: [id])
  courseAssignment CourseAssignment    @relation(fields: [courseAssignmentId], references: [id])
  template         PlanningTemplate    @relation(fields: [templateId], references: [id])
  creator          User                @relation("CurriculumPlanCreator", fields: [createdBy], references: [id])
  approver         User?               @relation("CurriculumPlanApprover", fields: [approvedBy], references: [id])
  situations       LearningSituation[]

  @@unique([courseAssignmentId])
  @@map("curriculum_plans")
}

// "Situación de aprendizaje" — el documento de Planificación Microcurricular real,
// uno por trimestre/periodo dentro del PCA. Contiene N semanas (PlanningWeek).
// Flujo de aprobación en 2 pasos, replicando el pie de firmas del formato oficial:
// Elaborado (docente) -> Revisado (director de área/subnivel) -> Aprobado (subdirección).
model LearningSituation {
  id                          String    @id @default(uuid())
  institutionId               String    @map("institution_id")
  planId                      String    @map("plan_id")
  academicPeriodId            String    @map("academic_period_id")
  title                       String    @db.VarChar(200)
  description                 String?
  // Fechas del bloque — equivalente a "Fecha inicio"/"Fecha fin" de TIGA, usadas
  // por ambos modelos de planificación (opcional para destrezas, que no las pedía).
  startDate                   DateTime? @map("start_date") @db.Date
  endDate                     DateTime? @map("end_date") @db.Date
  // DEPRECADO — IDs de CurriculumArea. Nunca tuvo UI que lo escribiera (revisado
  // en el código: 0 escrituras reales antes de este cambio). Se conserva la
  // columna para no romper filas que pudieran existir, pero el selector nuevo de
  // "Conexión interdisciplinar" usa interdisciplinarySubjectIds en su lugar.
  interdisciplinaryAreaIds    String[]  @map("interdisciplinary_area_ids")
  // IDs de Subject (materias) del propio docente con las que esta situación
  // declara conexión interdisciplinar — pedido explícito del usuario: elegir
  // entre SUS materias asignadas (CourseAssignment), no el catálogo completo de
  // la institución. Mínimo 2 para contar como interdisciplinar (se valida en la
  // UI/uso, no aquí — la persistencia acepta cualquier cantidad, incluida 0/1,
  // para no bloquear guardados parciales mientras el docente decide).
  interdisciplinarySubjectIds String[]  @map("interdisciplinary_subject_ids")
  // Competencias del bloque (modelo CNC). Se eligen UNA vez al crear la situación
  // y de aquí las toma el generador de semanas — antes el docente tenía que
  // volver a elegirlas en el panel de IA aunque ya las hubiera indicado.
  competencyIds               String[]  @map("competency_ids")
  // "borrador" | "listo" — SIN flujo de aprobación por terceros (pedido explícito
  // del usuario: solo el docente decide, transición libre en ambos sentidos).
  // Antes existían "enviado"/"revisado"/"aprobado" (flujo de 2 pasos director de
  // área -> subdirección) — migrados a "listo" en 20261016000000_situation_status_simplify.
  // reviewedBy/reviewedAt/approvedBy/approvedAt quedan en desuso (se conservan
  // por histórico, ya no se escriben).
  status                      String    @default("borrador") @db.VarChar(20)
  createdBy                   String    @map("created_by")
  reviewedBy                  String?   @map("reviewed_by")
  reviewedAt                  DateTime? @map("reviewed_at")
  approvedBy                  String?   @map("approved_by")
  approvedAt                  DateTime? @map("approved_at")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  institution    Institution    @relation(fields: [institutionId], references: [id])
  plan           CurriculumPlan @relation(fields: [planId], references: [id])
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id])
  creator        User           @relation("LearningSituationCreator", fields: [createdBy], references: [id])
  reviewer       User?          @relation("LearningSituationReviewer", fields: [reviewedBy], references: [id])
  approver       User?          @relation("LearningSituationApprover", fields: [approvedBy], references: [id])
  weeks          PlanningWeek[]

  @@index([planId, academicPeriodId])
  @@map("learning_situations")
}

// Una semana dentro de la situación de aprendizaje — estructura fija que replica
// la tabla del formato oficial: competencias/indicadores, saberes por tipo
// (declarativo/procedimental/actitudinal) y los 3 momentos metodológicos.
model PlanningWeek {
  id                      String    @id @default(uuid())
  institutionId           String    @map("institution_id")
  situationId             String    @map("situation_id")
  weekNumber              Int       @map("week_number")
  name                    String?   @db.VarChar(150)
  startDate               DateTime? @map("start_date") @db.Date
  endDate                 DateTime? @map("end_date") @db.Date
  competenciasEspecificas String?   @map("competencias_especificas")
  indicadoresEvaluacion   String?   @map("indicadores_evaluacion")
  // Destrezas del banco curricular en las que se basa la semana (modelo "destrezas")
  skillIds                String[]  @map("skill_ids")
  // Saberes (CurriculumSaber) seleccionados, cualquier tipo — se agrupan por type al mostrar/exportar
  saberIds                String[]  @map("saber_ids")
  // Competencias específicas y sus indicadores en las que se basa la semana (modelo "competencias")
  competencyIds           String[]  @map("competency_ids")
  competencyIndicatorIds  String[]  @map("competency_indicator_ids")
  // Saberes (CompetencySaber) del modelo por competencias
  competencySaberIds      String[]  @map("competency_saber_ids")
  // { anticipacion: {estrategiasDua, recursos, tecnica, instrumento}, construccionConocimiento: {...}, consolidacion: {...} }
  momentos                Json      @default("{}")
  // Multigrado: si esta semana pertenece a un bloque multigrado, apunta a la
  // experiencia común que la conecta con las semanas equivalentes de los otros
  // grados participantes (mismo weekNumber-de-bloque, cada uno con SU PROPIO
  // PlanningWeek — nunca se mezcla contenido curricular entre grados, solo se
  // conectan por esta referencia). Null para toda semana no-multigrado.
  multigradeExperienceId  String?   @map("multigrade_experience_id")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  institution Institution                 @relation(fields: [institutionId], references: [id])
  situation   LearningSituation           @relation(fields: [situationId], references: [id])
  experience  MultigradeSharedExperience? @relation(fields: [multigradeExperienceId], references: [id])

  @@unique([situationId, weekNumber])
  @@map("planning_weeks")
}

// ============================================================
// MULTIGRADO (unidocente/pluridocente) — calcado de las reglas de negocio
// TIGA Multigrado v1.0: selección explícita grado+materia (nunca "todos los
// grados con todas las materias" implícito), BGU prohibido, 8vo-10mo EGB
// requiere extensión superior explícita, cada grado conserva su propio
// currículo/competencia/indicador/saberes independientes.
// ============================================================

// El "aula multigrado" que arma el wizard: agrupa los CourseAssignment (uno
// por grado×materia) que un mismo docente dicta a la vez en el mismo salón.
// No reemplaza CourseAssignment/Parallel — es una capa de agrupación para que
// el generador y el PDF sepan qué asignaciones deben coordinarse entre sí.
model MultigradeGroup {
  id                     String   @id @default(uuid())
  institutionId          String   @map("institution_id")
  teacherId              String   @map("teacher_id")
  academicYearId         String   @map("academic_year_id")
  name                   String   @db.VarChar(150)
  // Confirmación explícita del docente para incluir grados de 8vo-10mo EGB —
  // sin esto, el wizard rechaza esas selecciones (MULTIGRADO-v1.0-FREEZE.md).
  allowSuperiorExtension Boolean  @default(false) @map("allow_superior_extension")
  createdBy              String   @map("created_by")
  createdAt              DateTime @default(now()) @map("created_at")

  institution        Institution                  @relation(fields: [institutionId], references: [id])
  teacher            User                         @relation("MultigradeGroupTeacher", fields: [teacherId], references: [id])
  academicYear       AcademicYear                 @relation(fields: [academicYearId], references: [id])
  creator            User                         @relation("MultigradeGroupCreator", fields: [createdBy], references: [id])
  members            MultigradeGroupMember[]
  sharedExperiences  MultigradeSharedExperience[]

  @@map("multigrade_groups")
}

// Una fila por selección grado+materia explícita del docente — vínculo directo
// al CourseAssignment real ya creado (Parallel del grado + Subject elegida del
// catálogo). gradeCode usa la misma convención que Level.code (ej. "2B", "8B").
model MultigradeGroupMember {
  id                 String   @id @default(uuid())
  groupId            String   @map("group_id")
  gradeCode          String   @db.VarChar(20) @map("grade_code")
  courseAssignmentId String   @unique @map("course_assignment_id")
  parallelId         String   @map("parallel_id")
  subjectId          String   @map("subject_id")
  createdAt          DateTime @default(now()) @map("created_at")

  group            MultigradeGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  courseAssignment CourseAssignment @relation(fields: [courseAssignmentId], references: [id])
  parallel         Parallel         @relation(fields: [parallelId], references: [id])
  subject          Subject          @relation(fields: [subjectId], references: [id])

  @@map("multigrade_group_members")
}

// La "experiencia común" de una semana de bloque multigrado: título/contexto/
// propósito compartido que se plantea igual para toda el aula a la vez —
// NUNCA es un currículo común (cada grado sigue con su propia competencia,
// indicador y saberes en su propio PlanningWeek). weekNumber es relativo al
// bloque (1..N), igual para todas las semanas equivalentes de cada grado.
model MultigradeSharedExperience {
  id                    String   @id @default(uuid())
  institutionId         String   @map("institution_id")
  groupId               String   @map("group_id")
  academicPeriodId      String   @map("academic_period_id")
  weekNumber            Int      @map("week_number")
  title                 String   @db.VarChar(200)
  context               String
  commonPurpose         String   @map("common_purpose")
  // Códigos de grado (Level.code) que participan efectivamente en esta semana —
  // mínimo 2 (MINIMUM_SELECTIONS_REQUIRED de TIGA), normalmente = todos los del grupo.
  participantGradeCodes String[] @map("participant_grade_codes")
  createdBy             String   @map("created_by")
  createdAt             DateTime @default(now()) @map("created_at")

  institution    Institution     @relation(fields: [institutionId], references: [id])
  group          MultigradeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  academicPeriod AcademicPeriod  @relation(fields: [academicPeriodId], references: [id])
  creator        User            @relation("MultigradeExperienceCreator", fields: [createdBy], references: [id])
  weeks          PlanningWeek[]

  @@unique([groupId, academicPeriodId, weekNumber])
  @@map("multigrade_shared_experiences")
}

// ============================================================
// MATRÍCULA
// ============================================================

model StudentEnrollment {
  id              String   @id @default(uuid())
  institutionId   String   @map("institution_id")
  studentId       String   @map("student_id")
  parallelId      String   @map("parallel_id")
  academicYearId  String   @map("academic_year_id")
  enrolledAt      DateTime @default(now()) @map("enrolled_at")
  status          String   @default("active") @db.VarChar(20)
  // Adaptación curricular NEE: si tiene, el PUD la muestra automáticamente
  // para este estudiante en la sección DUA de cada unidad, sin que el
  // docente tenga que acordarse de agregarla manualmente.
  hasAdaptation   Boolean  @default(false) @map("has_adaptation")
  adaptationType  String?  @map("adaptation_type") @db.VarChar(20) // temporal | permanente
  adaptationNotes String?  @map("adaptation_notes")

  institution  Institution  @relation(fields: [institutionId], references: [id])
  student      User         @relation("StudentEnrollments", fields: [studentId], references: [id])
  parallel     Parallel     @relation(fields: [parallelId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, academicYearId])
  @@map("student_enrollments")
}

// ============================================================
// COMPORTAMIENTO (cualitativo por periodo)
// ============================================================

model BehaviorGrade {
  id               String   @id @default(uuid())
  institutionId    String   @map("institution_id")
  studentId        String   @map("student_id")
  academicPeriodId String   @map("academic_period_id")
  code             String   @db.VarChar(10) // de gradingConfig.behaviorScale (A–E)
  notes            String?
  recordedBy       String   @map("recorded_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  institution    Institution    @relation(fields: [institutionId], references: [id])
  student        User           @relation("StudentBehavior", fields: [studentId], references: [id])
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id])
  recorder       User           @relation("BehaviorRecorder", fields: [recordedBy], references: [id])

  @@unique([studentId, academicPeriodId])
  @@map("behavior_grades")
}

// Recuperación de una materia (supletorio / remedial / gracia) en el año lectivo
model SubjectRecovery {
  id                 String   @id @default(uuid())
  institutionId      String   @map("institution_id")
  studentId          String   @map("student_id")
  courseAssignmentId String   @map("course_assignment_id")
  academicYearId     String   @map("academic_year_id")
  type               String   @db.VarChar(20) // supletorio | remedial | gracia
  score              Decimal  @db.Decimal(5, 2)
  recordedBy         String   @map("recorded_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  institution      Institution      @relation(fields: [institutionId], references: [id])
  student          User             @relation("StudentRecovery", fields: [studentId], references: [id])
  courseAssignment CourseAssignment @relation(fields: [courseAssignmentId], references: [id])
  academicYear     AcademicYear     @relation(fields: [academicYearId], references: [id])
  recorder         User             @relation("RecoveryRecorder", fields: [recordedBy], references: [id])

  @@unique([studentId, courseAssignmentId, academicYearId])
  @@map("subject_recoveries")
}

// Recuperación pedagógica intra-trimestral (MINEDUC): por estudiante × asignación × período
model PedagogicRecovery {
  id                 String   @id @default(uuid())
  institutionId      String   @map("institution_id")
  studentId          String   @map("student_id")
  courseAssignmentId String   @map("course_assignment_id")
  academicPeriodId   String   @map("academic_period_id")
  score              Decimal? @db.Decimal(5, 2) // null = pendiente, número = nota registrada
  notes              String?
  recordedBy         String   @map("recorded_by")
  // Destreza que originó el candidato de refuerzo (detectado automáticamente por
  // notas bajas en Activity.curriculumSkillId). Null si se creó a mano sin ese origen.
  curriculumSkillId  String?  @map("curriculum_skill_id")
  // Origen del registro: "manual" (docente lo creó a mano) | "auto_detected" (sugerido por el sistema)
  source             String   @default("manual") @db.VarChar(20)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  institution      Institution      @relation(fields: [institutionId], references: [id])
  student          User             @relation("StudentPedagogicRecovery", fields: [studentId], references: [id])
  courseAssignment CourseAssignment @relation(fields: [courseAssignmentId], references: [id])
  academicPeriod   AcademicPeriod   @relation(fields: [academicPeriodId], references: [id])
  curriculumSkill  CurriculumSkill? @relation(fields: [curriculumSkillId], references: [id])
  recorder         User             @relation("PedagogicRecoveryRecorder", fields: [recordedBy], references: [id])

  @@unique([studentId, courseAssignmentId, academicPeriodId])
  @@index([institutionId, academicPeriodId])
  @@index([curriculumSkillId])
  @@map("pedagogic_recoveries")
}

// Plan de Refuerzo Académico Individualizado — documento formal por estudiante que
// agrupa las destrezas donde necesita refuerzo (detectadas automáticamente por notas
// bajas vía getSkillReinforcementCandidates, o por adaptación curricular NEE marcada
// en StudentEnrollment). Se imprime/archiva como PDF con firmas.
//
// Además de ese documento simple (usado por planType="nee"), este modelo es también
// el AGREGADO RAÍZ del flujo completo de refuerzo pedagógico (calcado del motor TIGA)
// para planType="academico": máquina de estados DETECTED→PLANNED→IN_REINFORCEMENT→
// EVALUATED→{CLOSED|CONTINUES_REINFORCEMENT}, propuesta editable, detección, plan
// temporal por semanas (ReinforcementPlanUnit), comunicaciones/compromisos/
// seguimientos/reevaluaciones y encadenamiento de ciclos (rootCaseId/previousCaseId).
// El campo `status` legado (borrador/activo/cerrado) sigue gobernando el flujo NEE
// simple; `caseStatus` gobierna la máquina de estados nueva para planType="academico"
// (ver apps/api/src/shared/domain/reinforcement-domain.ts).
model ReinforcementPlan {
  id                   String    @id @default(uuid())
  institutionId        String    @map("institution_id")
  studentId            String    @map("student_id")
  courseAssignmentId   String    @map("course_assignment_id")
  academicPeriodId     String    @map("academic_period_id")
  // "academico" (detectado por notas bajas en una o más destrezas) | "nee" (por adaptación curricular)
  planType             String    @db.VarChar(20)
  // "borrador" | "activo" | "cerrado" — flujo simple, usado tal cual por planType="nee"
  status               String    @default("borrador") @db.VarChar(20)
  objetivoGeneral      String?   @map("objetivo_general")
  estrategias          String?
  responsables         String?
  fechaInicio          DateTime? @map("fecha_inicio") @db.Date
  fechaSeguimiento     DateTime? @map("fecha_seguimiento") @db.Date
  observacionesFinales String?   @map("observaciones_finales")
  createdBy            String    @map("created_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // ── TIGA: máquina de estados del caso de refuerzo (planType="academico") ──
  // DETECTED|PLANNED|IN_REINFORCEMENT|EVALUATED|CLOSED|CONTINUES_REINFORCEMENT
  caseStatus                 String  @default("DETECTED") @map("case_status") @db.VarChar(30)
  mode                       String  @default("INDIVIDUAL") @db.VarChar(10) // INDIVIDUAL | GROUP
  modeAuthority              String? @map("mode_authority") @db.VarChar(40)
  rootCaseId                 String? @map("root_case_id")
  previousCaseId             String? @unique @map("previous_case_id")
  cycleNumber                Int     @default(1) @map("cycle_number")
  reinforcementDurationWeeks Int?    @map("reinforcement_duration_weeks")
  reinforcementFrequency     String? @map("reinforcement_frequency")

  // ── Detección (DetectionRecord) ──
  detectionSourceCode                 String?   @map("detection_source_code") @db.VarChar(40)
  detectionObservation                String?   @map("detection_observation")
  detectionEvidenceValue              String?   @map("detection_evidence_value")
  detectionPeriod                     String?   @map("detection_period")
  detectionInitialResult              String?   @map("detection_initial_result")
  detectionEvidenceOrigin             String?   @map("detection_evidence_origin")
  psychopedagogicalReportExists       Boolean   @default(false) @map("psychopedagogical_report_exists")
  psychopedagogicalAuthorityReference String?   @map("psychopedagogical_authority_reference")
  detectedOn                          DateTime? @map("detected_on") @db.Date

  // ── Necesidad(es) pedagógica(s) elegidas (catálogo fijo, ver reinforcement-catalog.ts) ──
  needCodes       String[] @map("need_codes")
  needObservation String?  @map("need_observation")

  // ── LearningTarget / EvaluationReference — snapshot neutral (no se re-deriva) ──
  learningTargetTitle       String?  @map("learning_target_title")
  learningTargetDescription String?  @map("learning_target_description")
  learningTargetActivities  String[] @map("learning_target_activities")
  learningTargetEvidence    String?  @map("learning_target_evidence")
  evaluationInstrument      String?  @map("evaluation_instrument")
  evaluationScaleType       String?  @default("NONE") @map("evaluation_scale_type") @db.VarChar(20)
  evaluationObservedResult  String?  @map("evaluation_observed_result")

  // ── ReinforcementProposal — editable por el docente hasta que confirma el plan ──
  proposalLearningToReinforce String? @map("proposal_learning_to_reinforce")
  proposalObjective           String? @map("proposal_objective")
  proposalActiveStrategy      String? @map("proposal_active_strategy")
  proposalConcreteActivity    String? @map("proposal_concrete_activity")
  proposalResource            String? @map("proposal_resource")
  proposalEvidence            String? @map("proposal_evidence")
  proposalEvaluation          String? @map("proposal_evaluation")
  proposalDurationFrequency   String? @map("proposal_duration_frequency")
  proposalExpectedResult      String? @map("proposal_expected_result")
  proposalAuthority           String? @default("TIGA_SUGGESTED") @map("proposal_authority") @db.VarChar(30)
  proposalTeacherConfirmed    Boolean @default(false) @map("proposal_teacher_confirmed")

  institution      Institution              @relation(fields: [institutionId], references: [id])
  student          User                     @relation("StudentReinforcementPlan", fields: [studentId], references: [id])
  courseAssignment CourseAssignment         @relation(fields: [courseAssignmentId], references: [id])
  academicPeriod   AcademicPeriod           @relation(fields: [academicPeriodId], references: [id])
  creator          User                     @relation("ReinforcementPlanCreator", fields: [createdBy], references: [id])
  skills           ReinforcementPlanSkill[]

  rootCase      ReinforcementPlan?  @relation("ReinforcementCaseRoot", fields: [rootCaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rootedCases   ReinforcementPlan[] @relation("ReinforcementCaseRoot")
  previousCase  ReinforcementPlan?  @relation("ReinforcementCasePrevious", fields: [previousCaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nextCycleCase ReinforcementPlan?  @relation("ReinforcementCasePrevious")

  participants   ReinforcementCaseStudent[]
  units          ReinforcementPlanUnit[]
  communications ReinforcementCommunication[]
  commitments    ReinforcementCommitment[]
  followUps      ReinforcementFollowUp[]
  reevaluations  ReinforcementReevaluation[]

  @@index([institutionId, academicPeriodId])
  @@index([studentId, courseAssignmentId, academicPeriodId])
  @@map("reinforcement_plans")
}

// Estudiante participante de un caso de refuerzo — normalmente solo el titular
// (ReinforcementPlan.studentId), salvo mode="GROUP" donde hay más de uno.
model ReinforcementCaseStudent {
  id        String @id @default(uuid())
  planId    String @map("plan_id")
  studentId String @map("student_id")

  plan    ReinforcementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  student User              @relation("ReinforcementCaseStudent", fields: [studentId], references: [id])

  @@unique([planId, studentId])
  @@map("reinforcement_case_students")
}

// Unidad temporal (una por semana) del plan generado por el motor determinista de
// refuerzo (reinforcement-planning-engine.ts) — 6 fases fijas calcadas de TIGA. Se
// regenera completa (delete+recreate) cada vez que se confirma un nuevo plan
// temporal, nunca se edita campo por campo.
model ReinforcementPlanUnit {
  id                   String   @id @default(uuid())
  planId               String   @map("plan_id")
  temporalIndex        Int      @map("temporal_index")
  phase                String   @db.VarChar(30)
  learningFocus        String   @map("learning_focus")
  specificObjective    String   @map("specific_objective")
  strategy             String
  concreteActivity     String   @map("concrete_activity")
  requiredResource     String   @map("required_resource")
  observableEvidence   String   @map("observable_evidence")
  evaluationMechanism  String   @map("evaluation_mechanism")
  frequency            String?
  advancementCriterion String   @map("advancement_criterion")
  nextStep             String   @map("next_step")
  createdAt            DateTime @default(now()) @map("created_at")

  plan ReinforcementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, temporalIndex])
  @@map("reinforcement_plan_units")
}

// Comunicación registrada con el representante durante el ciclo de refuerzo.
model ReinforcementCommunication {
  id                String   @id @default(uuid())
  planId            String   @map("plan_id")
  date              DateTime @db.Date
  mediumCode        String   @map("medium_code") @db.VarChar(30)
  mediumLabel       String   @map("medium_label")
  recipient         String   @default("Representante")
  institutionalText String   @map("institutional_text")
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  plan    ReinforcementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  creator User              @relation("ReinforcementCommunicationCreator", fields: [createdBy], references: [id])

  @@map("reinforcement_communications")
}

// Compromiso acordado (representante/estudiante) durante el ciclo de refuerzo.
model ReinforcementCommitment {
  id              String    @id @default(uuid())
  planId          String    @map("plan_id")
  commitmentCode  String    @map("commitment_code") @db.VarChar(30)
  commitmentLabel String    @map("commitment_label")
  responsible     String    @default("Representante y estudiante")
  targetDate      DateTime? @map("target_date") @db.Date
  note            String?
  createdBy       String    @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")

  plan    ReinforcementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  creator User              @relation("ReinforcementCommitmentCreator", fields: [createdBy], references: [id])

  @@map("reinforcement_commitments")
}

// Registro de seguimiento durante IN_REINFORCEMENT (solo válido en ese estado).
model ReinforcementFollowUp {
  id                   String   @id @default(uuid())
  planId               String   @map("plan_id")
  date                 DateTime @db.Date
  strategyApplied      String   @map("strategy_applied")
  evidence             String
  observation          String
  activityApplied      String?  @map("activity_applied")
  supportOrAdjustment  String?  @map("support_or_adjustment")
  observedProgress     String?  @map("observed_progress")
  persistentDifficulty String?  @map("persistent_difficulty")
  nextAction           String?  @map("next_action")
  createdBy            String   @map("created_by")
  createdAt            DateTime @default(now()) @map("created_at")

  plan    ReinforcementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  creator User              @relation("ReinforcementFollowUpCreator", fields: [createdBy], references: [id])

  @@map("reinforcement_follow_ups")
}

// Reevaluación (transición IN_REINFORCEMENT→EVALUATED) — requiere un resultado por
// cada estudiante participante (ReinforcementReevaluationOutcome).
model ReinforcementReevaluation {
  id                             String   @id @default(uuid())
  planId                         String   @map("plan_id")
  date                           DateTime @db.Date
  evaluation                     String
  persistentDifficulty           Boolean  @default(false) @map("persistent_difficulty")
  institutionalSupportSuggestion String?  @map("institutional_support_suggestion")
  initialResult                  String?  @map("initial_result")
  subsequentResult               String?  @map("subsequent_result")
  observedProgress               String?  @map("observed_progress")
  evidence                       String?
  // LEARNING_ACHIEVED | CONTINUE_REINFORCEMENT | MODIFY_STRATEGY_OR_SUPPORT | INSTITUTIONAL_FOLLOW_UP
  pedagogicalDecision            String?  @map("pedagogical_decision") @db.VarChar(40)
  createdBy                      String   @map("created_by")
  createdAt                      DateTime @default(now()) @map("created_at")

  plan     ReinforcementPlan                  @relation(fields: [planId], references: [id], onDelete: Cascade)
  creator  User                               @relation("ReinforcementReevaluationCreator", fields: [createdBy], references: [id])
  outcomes ReinforcementReevaluationOutcome[]

  @@map("reinforcement_reevaluations")
}

// Resultado individual de un estudiante en una reevaluación (N estudiantes x N reevaluaciones).
model ReinforcementReevaluationOutcome {
  id              String  @id @default(uuid())
  reevaluationId  String  @map("reevaluation_id")
  studentId       String  @map("student_id")
  result          String  @db.VarChar(20) // CONSOLIDATED | NOT_CONSOLIDATED
  assessmentValue String? @map("assessment_value")
  observation     String?

  reevaluation ReinforcementReevaluation @relation(fields: [reevaluationId], references: [id], onDelete: Cascade)
  student      User                      @relation("ReinforcementReevaluationOutcomeStudent", fields: [studentId], references: [id])

  @@unique([reevaluationId, studentId])
  @@map("reinforcement_reevaluation_outcomes")
}

// Destreza puntual cubierta por un plan de refuerzo, con la nota que disparó la
// detección (null si el plan es por NEE en vez de por notas bajas).
model ReinforcementPlanSkill {
  id                 String   @id @default(uuid())
  planId             String   @map("plan_id")
  // Exactamente uno de los dos según el planningModel de la institución (validado en la app)
  curriculumSkillId  String?  @map("curriculum_skill_id")
  competencyId       String?  @map("competency_id")
  averageAtDetection Decimal? @map("average_at_detection") @db.Decimal(5, 2)
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")

  plan            ReinforcementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  curriculumSkill CurriculumSkill?  @relation(fields: [curriculumSkillId], references: [id])
  competency      Competency?       @relation(fields: [competencyId], references: [id])

  @@unique([planId, curriculumSkillId])
  @@unique([planId, competencyId])
  @@map("reinforcement_plan_skills")
}

// ============================================================
// PROYECTOS INTERDISCIPLINARIOS
// ============================================================
// Un reto/situación compartido por un paralelo durante N semanas de un
// trimestre, donde ≥2 asignaturas (con sus propios docentes) contribuyen cada
// una con su aporte disciplinar (destrezas/saberes del banco ya existente) y
// actividades semana a semana. No pertenece a un solo PCA/docente — cualquier
// docente del paralelo puede iniciarlo, y cada asignatura se "une" con su
// propia CourseAssignment.

model InterdisciplinaryProject {
  id               String   @id @default(uuid())
  institutionId    String   @map("institution_id")
  parallelId       String   @map("parallel_id")
  academicPeriodId String   @map("academic_period_id")
  title            String   @db.VarChar(200)
  situacionReto    String?  @map("situacion_reto")
  contexto         String?
  propositoComun   String?  @map("proposito_comun")
  productoFinal    String?  @map("producto_final")
  weeksCount       Int      @map("weeks_count")
  // "borrador" | "enviado" | "aprobado"
  status           String   @default("borrador") @db.VarChar(20)
  createdBy        String   @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  institution    Institution                     @relation(fields: [institutionId], references: [id])
  parallel       Parallel                        @relation(fields: [parallelId], references: [id])
  academicPeriod AcademicPeriod                  @relation(fields: [academicPeriodId], references: [id])
  creator        User                            @relation("InterdisciplinaryProjectCreator", fields: [createdBy], references: [id])
  contributions  InterdisciplinaryContribution[]

  @@unique([parallelId, academicPeriodId, title])
  @@map("interdisciplinary_projects")
}

// Aporte disciplinar de UNA asignatura al proyecto ("6. Aportes disciplinares").
// courseAssignmentId define la asignatura + docente responsable de este aporte.
model InterdisciplinaryContribution {
  id                 String   @id @default(uuid())
  projectId          String   @map("project_id")
  courseAssignmentId String   @map("course_assignment_id")
  contribucion       String?
  responsabilidad    String?
  // Destrezas del banco curricular elegidas por este docente (su área+subnivel) — modelo "destrezas"
  skillIds           String[] @map("skill_ids")
  // Saberes (CurriculumSaber) elegidos/generados, mismo banco reusado del PUD
  saberIds           String[] @map("saber_ids")
  // Competencias específicas elegidas — modelo "competencias"
  competencyIds      String[] @map("competency_ids")
  competencySaberIds String[] @map("competency_saber_ids")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  project          InterdisciplinaryProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  courseAssignment CourseAssignment             @relation(fields: [courseAssignmentId], references: [id])
  weekEntries      InterdisciplinaryWeekEntry[]

  @@unique([projectId, courseAssignmentId])
  @@map("interdisciplinary_contributions")
}

// Integración por hitos ("7. Integración interdisciplinaria por hitos") — una
// fila por semana para una contribución (asignatura) específica.
model InterdisciplinaryWeekEntry {
  id                  String   @id @default(uuid())
  contributionId      String   @map("contribution_id")
  weekNumber          Int      @map("week_number")
  // Propósito general de la semana — igual para todas las asignaturas de esa
  // semana en el documento de referencia; se guarda redundante por fila para
  // simplicidad de queries (no requiere tabla ProjectWeek intermedia).
  weekProposito       String?  @map("week_proposito")
  faseInicio          String?  @map("fase_inicio")
  faseDesarrollo      String?  @map("fase_desarrollo")
  faseCierre          String?  @map("fase_cierre")
  propositoPedagogico String?  @map("proposito_pedagogico")
  evidencias          String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  contribution InterdisciplinaryContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@unique([contributionId, weekNumber])
  @@map("interdisciplinary_week_entries")
}

// Suscripciones push para notificaciones web (PWA)
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

// Decisión de promoción del estudiante en el año lectivo
model PromotionDecision {
  id             String   @id @default(uuid())
  institutionId  String   @map("institution_id")
  studentId      String   @map("student_id")
  academicYearId String   @map("academic_year_id")
  status         String   @db.VarChar(20) // promoted | not_promoted | pending
  notes          String?
  decidedBy      String   @map("decided_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  institution  Institution  @relation(fields: [institutionId], references: [id])
  student      User         @relation("StudentPromotion", fields: [studentId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  decider      User         @relation("PromotionDecider", fields: [decidedBy], references: [id])

  @@unique([studentId, academicYearId])
  @@map("promotion_decisions")
}

// ============================================================
// FICHA DE ANAMNESIS (configurable por institución)
// ============================================================

model AnamnesisTemplate {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  name          String   @db.VarChar(150)
  isDefault     Boolean  @default(false) @map("is_default")
  isActive      Boolean  @default(true) @map("is_active")
  schema        Json     @default("{}") // { sections: [{ title, fields: [{ key, label, type, required, options }] }] }
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution Institution       @relation(fields: [institutionId], references: [id])
  records     AnamnesisRecord[]

  @@map("anamnesis_templates")
}

model AnamnesisRecord {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  studentId     String   @map("student_id")
  templateId    String   @map("template_id")
  answers       Json     @default("{}")
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution Institution       @relation(fields: [institutionId], references: [id])
  student     User              @relation("StudentAnamnesis", fields: [studentId], references: [id], onDelete: Cascade)
  template    AnamnesisTemplate @relation(fields: [templateId], references: [id])
  creator     User              @relation("AnamnesisCreator", fields: [createdBy], references: [id])

  @@unique([studentId])
  @@map("anamnesis_records")
}

// ============================================================
// ACTIVIDADES Y CALIFICACIONES
// ============================================================

model ActivityType {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  name          String   @db.VarChar(100)
  code          String   @db.VarChar(50)
  description   String?
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order") @db.SmallInt
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")

  institution Institution @relation(fields: [institutionId], references: [id])
  activities  Activity[]

  @@unique([institutionId, code])
  @@map("activity_types")
}

model Insumo {
  id                 String   @id @default(uuid())
  institutionId      String   @map("institution_id")
  courseAssignmentId String   @map("course_assignment_id")
  academicPeriodId   String   @map("academic_period_id")
  name               String   @db.VarChar(100)
  sortOrder          Int      @default(0) @map("sort_order") @db.SmallInt
  weight             Decimal? @db.Decimal(5, 2)
  createdBy          String   @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")

  institution      Institution      @relation(fields: [institutionId], references: [id])
  courseAssignment CourseAssignment @relation(fields: [courseAssignmentId], references: [id])
  academicPeriod   AcademicPeriod   @relation(fields: [academicPeriodId], references: [id])
  creator          User             @relation("InsumoCreator", fields: [createdBy], references: [id])
  activities       Activity[]

  @@index([courseAssignmentId, academicPeriodId])
  @@map("insumos")
}

model Activity {
  id                 String    @id @default(uuid())
  institutionId      String    @map("institution_id")
  courseAssignmentId String    @map("course_assignment_id")
  academicPeriodId   String    @map("academic_period_id")
  activityTypeId     String    @map("activity_type_id")
  insumoId           String?   @map("insumo_id")
  taskId             String?   @unique @map("task_id")
  // Destreza del banco curricular a la que se vincula esta actividad. Con esto,
  // cada nota queda trazada a una sub-destreza específica, no solo al insumo
  // genérico — es lo que permite detectar automáticamente quién necesita refuerzo
  // por destreza (ver PedagogicRecovery.curriculumSkillId).
  curriculumSkillId  String?   @map("curriculum_skill_id")
  // Equivalente a curriculumSkillId para el modelo por COMPETENCIAS
  competencyId       String?   @map("competency_id")
  name               String    @db.VarChar(200)
  description        String?
  maxScore           Decimal   @default(10) @map("max_score") @db.Decimal(5, 2)
  activityDate       DateTime? @map("activity_date") @db.Date
  isPublished        Boolean   @default(false) @map("is_published")
  metadata           Json      @default("{}")
  createdBy          String    @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  institution      Institution      @relation(fields: [institutionId], references: [id])
  courseAssignment CourseAssignment @relation(fields: [courseAssignmentId], references: [id])
  academicPeriod   AcademicPeriod   @relation(fields: [academicPeriodId], references: [id])
  activityType     ActivityType     @relation(fields: [activityTypeId], references: [id])
  insumo           Insumo?          @relation(fields: [insumoId], references: [id])
  task             Task?            @relation(fields: [taskId], references: [id])
  curriculumSkill  CurriculumSkill? @relation(fields: [curriculumSkillId], references: [id])
  competency       Competency?      @relation(fields: [competencyId], references: [id])
  creator          User             @relation("ActivityCreator", fields: [createdBy], references: [id])
  grades           Grade[]

  @@index([courseAssignmentId, academicPeriodId])
  @@index([insumoId])
  @@index([curriculumSkillId])
  @@index([competencyId])
  @@map("activities")
}

model Grade {
  id            String    @id @default(uuid())
  institutionId String    @map("institution_id")
  activityId    String    @map("activity_id")
  studentId     String    @map("student_id")
  score         Decimal?  @db.Decimal(5, 2)
  isExcused     Boolean   @default(false) @map("is_excused")
  status        String    @default("entregado") @db.VarChar(20)
  notes         String?
  gradedBy      String?   @map("graded_by")
  gradedAt      DateTime? @map("graded_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id])
  activity    Activity    @relation(fields: [activityId], references: [id])
  student     User        @relation("StudentGrades", fields: [studentId], references: [id])
  grader      User?       @relation("GradeRecorder", fields: [gradedBy], references: [id])

  @@unique([activityId, studentId])
  @@index([studentId])
  @@map("grades")
}

// ============================================================
// ASISTENCIA
// ============================================================

model AttendanceRecord {
  id                 String   @id @default(uuid())
  institutionId      String   @map("institution_id")
  // Modo por materia → courseAssignmentId; modo diario → parallelId. Exactamente uno.
  courseAssignmentId String?  @map("course_assignment_id")
  parallelId         String?  @map("parallel_id")
  studentId          String   @map("student_id")
  date               DateTime @db.Date
  status             String   @default("present") @db.VarChar(20)
  notes              String?
  recordedBy         String   @map("recorded_by")
  createdAt          DateTime @default(now()) @map("created_at")

  institution      Institution               @relation(fields: [institutionId], references: [id])
  courseAssignment CourseAssignment?         @relation(fields: [courseAssignmentId], references: [id])
  parallel         Parallel?                 @relation(fields: [parallelId], references: [id])
  student          User                      @relation("StudentAttendance", fields: [studentId], references: [id])
  recorder         User                      @relation("AttendanceRecorder", fields: [recordedBy], references: [id])
  justifications   JustificationAttendance[]

  @@unique([courseAssignmentId, studentId, date])
  @@unique([parallelId, studentId, date])
  @@index([courseAssignmentId, date])
  @@index([parallelId, date])
  @@index([studentId])
  @@map("attendance_records")
}

model AbsenceJustification {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  studentId     String   @map("student_id")
  reason        String
  documentUrl   String?  @map("document_url") @db.VarChar(500)
  justifiedBy   String   @map("justified_by")
  createdAt     DateTime @default(now()) @map("created_at")

  institution       Institution               @relation(fields: [institutionId], references: [id])
  student           User                      @relation("StudentJustifications", fields: [studentId], references: [id])
  justifier         User                      @relation("JustificationCreator", fields: [justifiedBy], references: [id])
  attendanceRecords JustificationAttendance[]

  @@map("absence_justifications")
}

model JustificationAttendance {
  justificationId    String @map("justification_id")
  attendanceRecordId String @map("attendance_record_id")

  justification    AbsenceJustification @relation(fields: [justificationId], references: [id], onDelete: Cascade)
  attendanceRecord AttendanceRecord     @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  @@id([justificationId, attendanceRecordId])
  @@map("justification_attendance")
}

// ============================================================
// DISCIPLINA
// ============================================================

// Catálogo configurable de tipos de falta (espejo de ActivityType)
model IncidentType {
  id                 String   @id @default(uuid())
  institutionId      String   @map("institution_id")
  name               String   @db.VarChar(100)
  code               String   @db.VarChar(50)
  severity           String   @default("leve") @db.VarChar(20) // leve | grave | muy_grave
  description        String?
  requiresDece       Boolean  @default(false) @map("requires_dece")
  requiresCommitment Boolean  @default(false) @map("requires_commitment")
  isActive           Boolean  @default(true) @map("is_active")
  sortOrder          Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt          DateTime @default(now()) @map("created_at")

  institution Institution            @relation(fields: [institutionId], references: [id])
  incidents   DisciplinaryIncident[]

  @@unique([institutionId, code])
  @@map("incident_types")
}

model DisciplinaryIncident {
  id                 String    @id @default(uuid())
  institutionId      String    @map("institution_id")
  studentId          String    @map("student_id")
  reportedBy         String    @map("reported_by")
  incidentTypeId     String?   @map("incident_type_id")
  incidentDate       DateTime  @map("incident_date") @db.Date
  category           String    @db.VarChar(100)
  description        String
  severity           String    @default("low") @db.VarChar(20)
  status             String    @default("open") @db.VarChar(20)
  // Debido proceso
  workflowState      String    @default("reportado") @map("workflow_state") @db.VarChar(30)
  assignedDeceId     String?   @map("assigned_dece_id")
  assignedDeceAt     DateTime? @map("assigned_dece_at")
  guardianNotifiedAt DateTime? @map("guardian_notified_at")
  resolutionNotes    String?   @map("resolution_notes")
  resolvedAt         DateTime? @map("resolved_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  institution  Institution          @relation(fields: [institutionId], references: [id])
  student      User                 @relation("StudentIncidents", fields: [studentId], references: [id])
  reporter     User                 @relation("IncidentReporter", fields: [reportedBy], references: [id])
  incidentType IncidentType?        @relation(fields: [incidentTypeId], references: [id])
  assignedDece User?                @relation("IncidentDece", fields: [assignedDeceId], references: [id])
  events       IncidentEvent[]
  commitments  IncidentCommitment[]
  attachments  IncidentAttachment[]

  @@index([studentId, incidentDate])
  @@map("disciplinary_incidents")
}

// Bitácora / línea de tiempo del debido proceso
model IncidentEvent {
  id            String   @id @default(uuid())
  incidentId    String   @map("incident_id")
  institutionId String   @map("institution_id")
  actorId       String   @map("actor_id")
  type          String   @db.VarChar(40) // created | state_changed | note | dece_assigned | guardian_notified | commitment_created | attachment_added
  description   String?
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")

  incident    DisciplinaryIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  institution Institution          @relation(fields: [institutionId], references: [id])
  actor       User                 @relation("IncidentEventActor", fields: [actorId], references: [id])

  @@index([incidentId, createdAt])
  @@map("incident_events")
}

// Acta de compromiso
model IncidentCommitment {
  id            String    @id @default(uuid())
  incidentId    String    @map("incident_id")
  institutionId String    @map("institution_id")
  terms         String
  followUpDate  DateTime? @map("follow_up_date") @db.Date
  status        String    @default("draft") @db.VarChar(20) // draft | signed
  signatories   Json      @default("{}")
  createdBy     String    @map("created_by")
  signedAt      DateTime? @map("signed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  incident    DisciplinaryIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  institution Institution          @relation(fields: [institutionId], references: [id])
  creator     User                 @relation("IncidentCommitmentCreator", fields: [createdBy], references: [id])

  @@map("incident_commitments")
}

// Evidencias (espejo de TaskAttachment)
model IncidentAttachment {
  id            String   @id @default(uuid())
  incidentId    String   @map("incident_id")
  institutionId String   @map("institution_id")
  fileName      String   @map("file_name") @db.VarChar(255)
  storedName    String   @map("stored_name") @db.VarChar(255)
  mimeType      String   @map("mime_type") @db.VarChar(100)
  fileSize      Int      @map("file_size")
  uploadedBy    String   @map("uploaded_by")
  createdAt     DateTime @default(now()) @map("created_at")

  incident    DisciplinaryIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  institution Institution          @relation(fields: [institutionId], references: [id])
  uploader    User                 @relation("IncidentAttachmentUploader", fields: [uploadedBy], references: [id])

  @@map("incident_attachments")
}

// ============================================================
// ATENCIÓN A PADRES DE FAMILIA (bitácora)
// ============================================================

model ParentMeeting {
  id              String    @id @default(uuid())
  institutionId   String    @map("institution_id")
  studentId       String?   @map("student_id") // opcional: el profesor elige de qué niño es
  recordedBy      String    @map("recorded_by") // funcionario que atiende
  meetingDate     DateTime  @map("meeting_date") @db.Date
  meetingTime     String?   @map("meeting_time") @db.VarChar(8) // "14:30"
  visitorName     String    @map("visitor_name") @db.VarChar(160) // persona que se acercó
  visitorRelation String?   @map("visitor_relation") @db.VarChar(80) // parentesco
  subject         String    @db.VarChar(200) // asunto
  details         String // detalle de lo hablado
  agreements      String? // acuerdos / compromisos
  signatureKey    String?   @map("signature_key") @db.VarChar(255) // PNG de la firma en storage
  signedAt        DateTime? @map("signed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id])
  student     User?       @relation("StudentParentMeetings", fields: [studentId], references: [id])
  recorder    User        @relation("ParentMeetingRecorder", fields: [recordedBy], references: [id])

  @@index([institutionId, meetingDate])
  @@map("parent_meetings")
}

// ============================================================
// MENSAJERÍA
// ============================================================

model MessageThread {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  subject       String   @db.VarChar(300)
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  institution Institution @relation(fields: [institutionId], references: [id])
  creator     User        @relation("ThreadCreator", fields: [createdBy], references: [id])
  messages    Message[]

  @@map("message_threads")
}

model Message {
  id       String   @id @default(uuid())
  threadId String   @map("thread_id")
  senderId String   @map("sender_id")
  body     String
  sentAt   DateTime @default(now()) @map("sent_at")

  thread      MessageThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender      User                @relation("MessageSender", fields: [senderId], references: [id])
  recipients  MessageRecipient[]
  attachments MessageAttachment[]

  @@index([threadId, sentAt])
  @@map("messages")
}

model MessageAttachment {
  id         String   @id @default(uuid())
  messageId  String   @map("message_id")
  fileName   String   @map("file_name") @db.VarChar(255)
  storedName String   @map("stored_name") @db.VarChar(255)
  mimeType   String   @map("mime_type") @db.VarChar(100)
  fileSize   Int      @map("file_size")
  createdAt  DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

model MessageRecipient {
  messageId   String    @map("message_id")
  recipientId String    @map("recipient_id")
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipient User    @relation(fields: [recipientId], references: [id])

  @@id([messageId, recipientId])
  @@index([recipientId, isRead])
  @@map("message_recipients")
}

// ============================================================
// HORARIO
