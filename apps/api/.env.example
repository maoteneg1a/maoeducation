# Desarrollo local: generar .env con pnpm setup:local:env (no sobrescribe archivos).
NODE_ENV=development
PORT=3000

# Base de datos.
# - DATABASE_URL: en producción con PgBouncer, apunta al POOLER y agrega ?pgbouncer=true
# - DIRECT_URL: conexión DIRECTA a Postgres (la usan las migraciones). En local
#   ambas pueden ser iguales.
DATABASE_URL=postgresql://maoedu:maoedu_dev@localhost:5434/maoeducation
DIRECT_URL=postgresql://maoedu:maoedu_dev@localhost:5434/maoeducation

JWT_SECRET=GENERATE_LOCAL_JWT_SECRET
JWT_REFRESH_SECRET=GENERATE_LOCAL_JWT_REFRESH_SECRET
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173

# URL pública del BACKEND (esta API), NO del frontend — se usa para construir
# links absolutos a /uploads/... (recursos/PDFs generados por la IA de
# planificación, adjuntos, etc). Si no la configuras, cae al default
# http://localhost:3000 y esos links quedan rotos en producción.
API_PUBLIC_URL=http://localhost:3000

# Almacenamiento de archivos (adjuntos de tareas, mensajes, incidentes).
# Si no defines nada => "local" (disco, EFÍMERO en Railway: se borra al redeploy).
# Para producción usa un bucket S3-compatible (Cloudflare R2 recomendado):
#   STORAGE_DRIVER=s3
#   S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   S3_BUCKET=mao-uploads
#   S3_ACCESS_KEY_ID=...
#   S3_SECRET_ACCESS_KEY=...
#   S3_REGION=auto
STORAGE_DRIVER=local

# DECE se habilita desde la configuración institucional; no requiere clave de cifrado.
