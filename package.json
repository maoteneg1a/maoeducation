{
  "name": "maoeducation",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "postinstall": "pnpm --filter api db:generate",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start:api": "pnpm --filter api start:prod",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:migrate:prod": "pnpm --filter api db:migrate:prod",
    "db:generate": "pnpm --filter api db:generate",
    "db:seed": "pnpm --filter api db:seed",
    "db:studio": "pnpm --filter api db:studio",
    "setup:local:env": "node scripts/setup-local.mjs --env-only",
    "setup:local": "node scripts/setup-local.mjs",
    "dev:local": "bash scripts/dev.sh",
    "db:up": "docker compose up -d --wait postgres18",
    "db:stop": "docker compose stop postgres18",
    "test:setup": "node --test scripts/setup-local.test.mjs",
    "docs:sync": "node scripts/generate-platform-docs.mjs",
    "docs:check": "node scripts/generate-platform-docs.mjs --check"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  }
}
